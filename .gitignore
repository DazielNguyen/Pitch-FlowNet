# Pitch-FlowNet: what stays out of Git.
# Ignored files stay on the workstation; they are NOT deleted. See docs/artifacts.md.

# Datasets and features (LJ Speech as used, the processed cache with spectrogram and F0 tensors)
datasets/raw/
datasets/processed/

# Model and run artifacts
*.ckpt
*.pt
*.pth
*.onnx
*.wav
events.out.tfevents.*

# Full local manifests (too large for Git). The tracked subset is manifests/file-manifest-core.json.
/SHA256SUMS
/manifests/file-manifest.json

# Private originals that are not published in any form
history/private/
# unpublished manuscript drafts (they carry author contact details)
evidence/manuscript/
# author working notes on manuscript revisions
history/notes/
history/prior-audits-2026-09-23/PitchFlowNet_Conference_Draft_2026-09-24.txt
