/docs/camera-ready/data-sync.md
/history/*
!/history/environment/
/tools/build_pitchflownet_record*.py
/manifests/camera-ready/commit-map-*.json

# Build outputs, environments and caches
__pycache__/
*.pyc
*.so
*.pyd
*.egg-info/
build/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
